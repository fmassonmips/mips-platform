# Root .htaccess
# Ideally, set Apache DocumentRoot directly to the /public directory.
# This file is a fallback that redirects every request into /public so
# nothing outside the public folder is ever served.

Options -Indexes
ServerSignature Off

# No <IfModule>: without mod_rewrite Apache must fail (500) rather than serve the repository.
RewriteEngine On

# Do not rewrite requests that already target /public/
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]

RedirectMatch 404 /\.git

# Block access to sensitive files at the repo root
<FilesMatch "^(composer\.(json|lock)|\.env.*|\.git.*|README.*|.*\.md|.*\.sql)$">
    Require all denied
</FilesMatch>
