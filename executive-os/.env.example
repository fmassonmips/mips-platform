# Runtime connection — role WITHOUT BYPASSRLS (tenant isolation enforced by Postgres RLS)
DATABASE_URL=postgres://mips_app:app_dev_pw@localhost:5432/mips_eos
# Owner connection — migrations, provisioning and demo seeding only. Never used by the web app.
DATABASE_OWNER_URL=postgres://mips_owner:owner_dev_pw@localhost:5432/mips_eos
# 32+ random bytes, used for CSRF/session HMAC. Generate: openssl rand -hex 32
APP_SECRET=change-me-dev-secret-change-me-dev-secret
# Set to 'true' only behind HTTPS
COOKIE_SECURE=false
# Optional AI analyst provider. Without a key the deterministic grounded analyst is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Optional error monitoring sink (HTTP endpoint receiving JSON error events)
ERROR_WEBHOOK_URL=
LOG_LEVEL=info
