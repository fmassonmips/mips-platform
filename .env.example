# PassPass Platform — environment configuration (sample)
#
# Copy to .env and fill in real values for your environment. NEVER commit .env.
# config/config.php reads these via getenv() and falls back to safe dev defaults.

# --- App -------------------------------------------------------------------
APP_ENV=development            # development | production

# --- Database (MariaDB) ----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mips_platform
DB_USER=mips_user
DB_PASS=change_me_in_production
DB_ROOT_PASS=root_change_me    # used by docker-compose for the MariaDB root

# --- Regulatory / entity ---------------------------------------------------
REGULATED_ENTITY=PassPass
TECHNOLOGY_PROVIDER=MIPSIT Digital Ltd
PARTNER_BANK=Partner Bank
PLATFORM_SANDBOX=1             # 1 = sandbox/prototype (default)

# --- Providers (secrets: leave blank in sandbox) ---------------------------
PASSPASS_ENABLED=1
PASSPASS_MODE=sandbox          # sandbox | live
PASSPASS_BASE_URL=
PASSPASS_API_KEY=
PASSPASS_WEBHOOK_SECRET=

PAYPUMP_ENABLED=1
PAYPUMP_MODE=sandbox
PAYPUMP_BASE_URL=
PAYPUMP_API_KEY=
PAYPUMP_WEBHOOK_SECRET=

INFLOW_ENABLED=1
INFLOW_MODE=sandbox
INFLOW_BASE_URL=
INFLOW_API_KEY=
INFLOW_WEBHOOK_SECRET=

CARDRAIL_ENABLED=1             # always stub mode; no PCI scope
